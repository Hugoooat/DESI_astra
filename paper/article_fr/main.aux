\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Monopôle (haut) et quadrupôle (bas) des classes ASTRA des points aléatoires sur le catalogue fiduciel : cross-corrélation avec les galaxies (gauche) et auto-corrélation (centre) des feuillets et des filaments, et cross-corrélation des vides et des nœuds (droite, autre échelle). Lignes et bandes : moyenne et dispersion à $1\sigma $ des 64 sous-volumes ; tirets : 2PCF. Les filaments se comportent comme le quartile surdense Q4 et les feuillets comme le quartile sous-dense Q1 ; les vides et les nœuds ne contiennent que $\sim 150$ et $\sim 30$ points aléatoires par sous-volume, d'où leur grande dispersion.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:classes_mp}{{1}{6}{Monopôle (haut) et quadrupôle (bas) des classes ASTRA des points aléatoires sur le catalogue fiduciel : cross-corrélation avec les galaxies (gauche) et auto-corrélation (centre) des feuillets et des filaments, et cross-corrélation des vides et des nœuds (droite, autre échelle). Lignes et bandes : moyenne et dispersion à $1\sigma $ des 64 sous-volumes ; tirets : 2PCF. Les filaments se comportent comme le quartile surdense Q4 et les feuillets comme le quartile sous-dense Q1 ; les vides et les nœuds ne contiennent que $\sim 150$ et $\sim 30$ points aléatoires par sous-volume, d'où leur grande dispersion}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Environnements ASTRA et density split sur le catalogue fiduciel (\texttt  {c000}, \texttt  {hod239}, ligne de visée $z$). Gauche, milieu : probabilité qu'un point d'un quartile ASTRA donné tombe dans chaque quartile du density split, pour les galaxies et les points aléatoires (moyenne sur 64 sous-volumes). Droite : $r$ d'ASTRA en fonction du contraste de densité lissé pour un échantillon de galaxies (léger décalage vertical aléatoire ajouté au $r$ discret).}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:env}{{2}{6}{Environnements ASTRA et density split sur le catalogue fiduciel (\texttt {c000}, \texttt {hod239}, ligne de visée $z$). Gauche, milieu : probabilité qu'un point d'un quartile ASTRA donné tombe dans chaque quartile du density split, pour les galaxies et les points aléatoires (moyenne sur 64 sous-volumes). Droite : $r$ d'ASTRA en fonction du contraste de densité lissé pour un échantillon de galaxies (léger décalage vertical aléatoire ajouté au $r$ discret)}{figure.caption.11}{}}
